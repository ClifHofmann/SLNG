; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Puris Viewer"
config/description="Next-gen Second Life / OpenSim viewer"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

; No Godot boot splash on an alpha release -- the client shows its own login screen with the
; version on it, and the engine logo in front of that only says which engine it is.
boot_splash/show_image=false
boot_splash/bg_color=Color(0.04, 0.05, 0.07, 1)

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[dotnet]

project/assembly_name="SLNG.App"

[rendering]

anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=16

[shader_globals]

slng_ambient={
"type": "color",
"value": Color(0.25, 0.25, 0.25, 1)
}
slng_blue_density={
"type": "color",
"value": Color(0.2447, 0.4487, 0.7599, 1)
}
slng_blue_horizon={
"type": "color",
"value": Color(0.4954, 0.4954, 0.6399, 1)
}
slng_haze_density={
"type": "float",
"value": 0.7
}
slng_haze_horizon={
"type": "float",
"value": 0.19
}
slng_density_multiplier={
"type": "float",
"value": 0.0001
}
slng_distance_multiplier={
"type": "float",
"value": 0.8
}
slng_max_y={
"type": "float",
"value": 1605.0
}
slng_glow={
"type": "color",
"value": Color(5, 0.001, -0.4799, 1)
}
slng_cloud_shadow={
"type": "float",
"value": 0.2699
}
slng_sun_moon_glow_factor={
"type": "float",
"value": 1.0
}
slng_dome_offset={
"type": "float",
"value": 0.96
}
slng_sunlight_color={
"type": "color",
"value": Color(0.7342, 0.7815, 0.8999, 1)
}
slng_sun_disc_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
slng_moonlight_color={
"type": "color",
"value": Color(0.5, 0.5, 0.5, 1)
}
slng_haze_color={
"type": "color",
"value": Color(0.5, 0.5, 0.5, 1)
}
slng_star_brightness={
"type": "float",
"value": 250.0
}
slng_sun_direction_view={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
slng_sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
slng_moon_direction={
"type": "vec3",
"value": Vector3(0, -1, 0)
}
slng_sun_scale={
"type": "float",
"value": 1.0
}
slng_moon_scale={
"type": "float",
"value": 1.0
}
slng_moon_brightness={
"type": "float",
"value": 0.5
}
slng_cloud_color={
"type": "color",
"value": Color(0.4099, 0.4099, 0.4099, 1)
}
slng_cloud_pos_density1={
"type": "color",
"value": Color(1, 0.526, 1, 1)
}
slng_cloud_pos_density2={
"type": "color",
"value": Color(1, 0.526, 1, 1)
}
slng_cloud_scale={
"type": "float",
"value": 0.4199
}
slng_cloud_variance={
"type": "float",
"value": 1.0
}

[rendering]

lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
