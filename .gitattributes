# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize or diff as text
*.png binary
*.jpg binary
*.j2c binary
*.pck binary
*.glb binary
*.dll binary
