<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SLNG.Assets</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreJ2K" Version="2.3.3.91" />
    <PackageReference Include="CoreJ2K.Skia" Version="2.3.3.91" />
    <PackageReference Include="LibreMetaverse" Version="3.1.3" />
    <PackageReference Include="LibreMetaverse.Rendering.MeshFoundry" Version="3.1.3" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.15.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- The base SkiaSharp package ships native binaries for Windows/macOS only. Linux (the CI
         test runner, and any Linux dev/server build) must reference the native assets explicitly
         or SKImageInfo's static ctor throws TypeInitializationException. NoDependencies bundles
         freetype/fontconfig so a headless runner needs no apt packages. Keep the version pinned
         in lockstep with SkiaSharp above. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SLNG.Core\SLNG.Core.csproj" />
    <ProjectReference Include="..\SLNG.Net\SLNG.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SLNG.Assets.Tests" />
  </ItemGroup>

</Project>
