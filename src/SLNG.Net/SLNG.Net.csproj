    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SLNG.Net</RootNamespace>
  </PropertyGroup>


  <ItemGroup>
