    <PackageReference Include="CoreJ2K.Skia" Version="2.3.0.81" />
    <PackageReference Include="LibreMetaverse" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SLNG.Core\SLNG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SLNG.Net.Tests" />
